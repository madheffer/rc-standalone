# Build output
bin/
obj/
*.user
*.suo
.vs/
.idea/
TestResults/

# Vendored upstream source, fetched and patched by tools/vendor.cs.
# Not committed: it is someone else's repository, pinned by sha in
# third_party/VENDORED.json and reproduced by the vendor step.
third_party/ValveResourceFormat/

# Native encoder build output (CMake); the sources ARE committed.
src/Source2.Compiler/Native/bc7enc/build/
src/Source2.Compiler/Native/bc7enc/bin/

# python probe caches
__pycache__/
*.pyc
tools/map-survey/*.json
tools/map-survey/*.txt

# The vis corpus is generated from the tester own CS2 content, per machine.
tools/vis/corpus.tsv

# Reverse-engineering inputs and outputs kept beside the tools that use them:
# Valve's DLL builds (not ours to publish), patch_check's state (copies of game
# files) and reports, and tool output.
tools/re/binaries/
tools/re/patch_state/
tools/re/patch_reports/
tools/re/out/
