<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler.Cli</RootNamespace>
    <AssemblyName>s2c</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source2.Compiler\Source2.Compiler.csproj" />
    <ProjectReference Include="..\Source2.Compiler.Gpu\Source2.Compiler.Gpu.csproj" />
  </ItemGroup>

</Project>
