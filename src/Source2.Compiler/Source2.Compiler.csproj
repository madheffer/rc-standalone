<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source2.Compiler - authors compiled Source 2 resources in pure managed code.

    No project references: the container, KV3 binary (every version, read and
    written as tier0 writes it), RED2, RERL ids, texture/mip/BC encoding and the
    KV3 text -> _c path are all this library, LZ4 included. The KV tree type is ValveKeyValue's
    KVObject and a VPK is read with ValvePak (both plain NuGet packages, no
    patches). Hosts that hold ValveResourceFormat objects use the separate
    Source2.Compiler.Vrf adapter.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler</RootNamespace>
    <AssemblyName>Source2.Compiler</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8002;CS1591</NoWarn>
    <!-- Native/ holds the vendored bc7enc C sources; keep them out of the
         default item globs (they are built by CMake, not msbuild). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Native\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- NuGet package (tools/pack.ps1, tools/pack.sh; docs/CONSUMING.md). -->
  <PropertyGroup>
    <PackageId>Source2.Compiler</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>vpkeditor.xyz</Authors>
    <Company>vpkeditor.xyz</Company>
    <Copyright>Copyright (c) 2026 vpkeditor.xyz</Copyright>
    <Description>Compiles and edits Counter-Strike 2 (Source 2) resources byte for byte as Valve's resourcecompiler does, with no Valve tools and no VRF: KV3 resources, sounds, vector graphics, textures (.vtex: RGBA8888, DXT1/5, ATI1N/2N, BC7), materials (.vmat with their child textures) and model editing (meshopt buffers).</Description>
    <PackageTags>source2;cs2;counter-strike;resourcecompiler;vtex;vmat;vmdl;kv3;valve</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <!-- Symbols with every source embedded, so a debugger needs no source server. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="README.md" />
    <!-- rsqrtps per CPU vendor, for normal maps (Texture/Rc/RcNormalMaps.cs). -->
    <EmbeddedResource Include="Texture/Rc/rsqrt_amd.txt;Texture/Rc/rsqrt_intel.txt" LogicalName="Source2.Compiler.RcTexture.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Source2.Compiler.Cli" />
    <InternalsVisibleTo Include="Source2.Compiler.Tests" />
    <InternalsVisibleTo Include="Source2.Compiler.Vrf" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library takes ILogger by interface only; the host wires the impl. -->
    <Using Include="Microsoft.Extensions.Logging" />
    <!-- The KVObject helpers every part of the library reads trees with. -->
    <Using Include="Source2.Compiler.KeyValues" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      ValveKeyValue is the one package a host is likely to pin lower, because its
      own ValveResourceFormat references it (vpkstuff's VRF uses 0.70.0.499). Both
      0.70.0.499 and 0.71.0.528 build this library and give the same output (75,457
      builder, decompile and recompile results over pak01, 2026-10-13). A host sets this to its version
      rather than loading two.
    -->
    <Source2CompilerValveKeyValueVersion Condition="'$(Source2CompilerValveKeyValueVersion)' == ''">0.71.0.528</Source2CompilerValveKeyValueVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <!-- The KV tree (KVObject) and KV3 text; the VPK reader for template lookup. -->
    <PackageReference Include="ValveKeyValue" Version="$(Source2CompilerValveKeyValueVersion)" />
    <PackageReference Include="ValvePak" Version="6.0.0.182" />
    <!-- KV3 Zstd blocks; RED2 CRCs. LZ4 is our own (Compression/), as tier0's lz4 1.9.3+ writes it. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <!-- Image decode/encode + mip generation, and the managed BC1/BC3/BC7 fallback. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
  </ItemGroup>

  <!-- Valve's BC7 encoder (bc7e, level 6) with one CPU vendor's rcpps table each, prebuilt by
       Native/bc7e/build.ps1 and build.sh; RcTexture.Bc7e loads them from runtimes/<rid>/native. -->
  <ItemGroup>
    <Content Include="Native\bc7e\prebuilt\win-x64\*.dll" Link="runtimes\win-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" PackagePath="runtimes\win-x64\native" />
    <Content Include="Native\bc7e\prebuilt\linux-x64\*.so" Link="runtimes\linux-x64\native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" PackagePath="runtimes\linux-x64\native" />
  </ItemGroup>

  <ItemGroup>
    <!-- Optional native BC7 encoder. Absent (no C toolchain) => Bc7Native.Available
         is false and BuildTexture transparently falls back to BCnEncoder.Net.
         Build it with cmake; see Native/bc7enc/CMakeLists.txt. -->
    <Content Include="Native\bc7enc\bin\bc7enc_native.dll" Condition="Exists('Native\bc7enc\bin\bc7enc_native.dll')" Link="bc7enc_native.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\bc7enc\bin\libbc7enc_native.so" Condition="Exists('Native\bc7enc\bin\libbc7enc_native.so')" Link="libbc7enc_native.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
