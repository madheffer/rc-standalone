<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source2.Compiler.Vrf - the compiler's operations on ValveResourceFormat
    objects (Resource, Block, IFileLoader), for a host that already holds them.
    Source2.Compiler itself does not reference VRF; only this adapter does.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler</RootNamespace>
    <AssemblyName>Source2.Compiler.Vrf</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8002;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Source2.Compiler.Cli" />
    <InternalsVisibleTo Include="Source2.Compiler.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      Which ValveResourceFormat to build against. Defaults to the copy this
      repository vendors and patches (tools/vendor.cs). A host that already
      vendors its own patched VRF - and so must not end up with two assemblies
      of the same name - overrides this to point at that one:

        <PropertyGroup>
          <Source2CompilerVrfProject>...\ValveResourceFormat.csproj</Source2CompilerVrfProject>
        </PropertyGroup>
        <ProjectReference Include="...\Source2.Compiler.Vrf.csproj" />

      The host's copy must be pinned to the sha in third_party/VENDORED.json and
      carry at least the patches in third_party/patches. A superset is fine.
    -->
    <Source2CompilerVrfProject Condition="'$(Source2CompilerVrfProject)' == ''">$(MSBuildThisFileDirectory)..\..\third_party\ValveResourceFormat\ValveResourceFormat\ValveResourceFormat.csproj</Source2CompilerVrfProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Source2CompilerVrfProject)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source2.Compiler\Source2.Compiler.csproj" />
  </ItemGroup>

</Project>
