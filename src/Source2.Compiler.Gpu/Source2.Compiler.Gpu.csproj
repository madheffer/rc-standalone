<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Source2.Compiler.Gpu - the parts of the compile Valve does on the GPU,
    run on the GPU here too (Vulkan, so the same on Windows and Linux):
    physicsbuilder's material sampler, rendering the material's own ToolsVis
    programs from the Vulkan shader build.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Source2.Compiler.Gpu</RootNamespace>
    <AssemblyName>Source2.Compiler.Gpu</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source2.Compiler\Source2.Compiler.csproj" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.22.0" />
  </ItemGroup>

</Project>
