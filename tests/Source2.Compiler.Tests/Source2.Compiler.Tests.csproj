<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Source2.Compiler.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The vphysics2 oracle tests hand raw structs to the DLL. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Source2.Compiler\Source2.Compiler.csproj" />
    <ProjectReference Include="..\..\src\Source2.Compiler.Gpu\Source2.Compiler.Gpu.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real resourcecompiler.exe inputs + outputs; the parity gate reads them
         from the source tree via a walk-up, and from the bin dir in a sandbox. -->
    <None Include="RcReference\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cases run through the binary under an emulator (tools/re/emu_*.py). -->
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The byte signatures that find visbuilder.dll's addresses in whatever
         build is installed. BinarySignatures walks up for it, so this copy is
         only for a sandbox with no source tree above the binary. -->
    <None Include="..\..\docs\visbuilder.signatures.json"
          Link="docs\visbuilder.signatures.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
