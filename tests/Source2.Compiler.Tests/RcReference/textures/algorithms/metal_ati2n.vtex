<!-- dmx encoding keyvalues2_noids 1 format vtex 1 -->
"CDmeVtex"
{
	"m_inputTextureArray" "element_array"
	[
		"CDmeInputTexture"
		{
			"m_name" "string" "rough"
			"m_fileName" "string" "materials/s2calg/rough64.png"
			"m_colorSpace" "string" "linear"
			"m_typeString" "string" "2D"
			"m_imageProcessorArray" "element_array"
			[
				"CDmeImageProcessor"
				{
					"m_algorithm" "string" "Inverse"
					"m_stringArg" "string" ""
					"m_vFloat4Arg" "vector4" "0 0 0 0"
				}
			]
		},
		"CDmeInputTexture"
		{
			"m_name" "string" "metal"
			"m_fileName" "string" "materials/s2calg/noisy64.png"
			"m_colorSpace" "string" "linear"
			"m_typeString" "string" "2D"
		}
	]
	"m_outputTypeString" "string" "2D"
	"m_outputFormat" "string" "ATI2N"
	"m_textureOutputChannelArray" "element_array"
	[
		"CDmeTextureOutputChannel"
		{
			"m_inputTextureArray" "string_array" [ "rough" ]
			"m_srcChannels" "string" "r"
			"m_dstChannels" "string" "r"
			"m_mipAlgorithm" "CDmeImageProcessor"
			{
				"m_algorithm" "string" "BoxInverse"
				"m_stringArg" "string" ""
				"m_vFloat4Arg" "vector4" "0 0 0 0"
			}
			"m_outputColorSpace" "string" "linear"
		},
		"CDmeTextureOutputChannel"
		{
			"m_inputTextureArray" "string_array" [ "metal" ]
			"m_srcChannels" "string" "r"
			"m_dstChannels" "string" "g"
			"m_mipAlgorithm" "CDmeImageProcessor"
			{
				"m_algorithm" "string" "Box"
				"m_stringArg" "string" ""
				"m_vFloat4Arg" "vector4" "0 0 0 0"
			}
			"m_outputColorSpace" "string" "linear"
		}
	]
}
